# Porta do servidor (padrão: 4000)
PORT=4000

# Privy App ID e Secret (obter em dashboard.privy.io)
PRIVY_APP_ID=
PRIVY_APP_SECRET=

# Origens CORS permitidas (separadas por vírgula)
ALLOWED_ORIGINS=http://localhost:3000

# Database (PostgreSQL via Prisma)
DATABASE_URL=

# Stellar — Emissor mockado de USDC (Hi-Li simulado, Testnet only)
# WHY: O backend usa o secret para emitir o payment de USDC após a Trustline.
# Gerar uma conta nova na testnet: stellar keys generate issuer --network testnet
ISSUER_PUBLIC_KEY=
ISSUER_SECRET_KEY=
STELLAR_SPONSOR_SECRET=

# Etherfuse Sandbox
ETHERFUSE_API_URL=
ETHERFUSE_API_KEY=
ETHERFUSE_BANK_ACCOUNT_ID=
ETHERFUSE_CUSTOMER_ID=
TESOURO_ASSET_IDENTIFIER=
TESOURO_ISSUER_PUBLIC_KEY=

# Defindex — Motor de Rendimentos (Vaults)
DEFINDEX_API_KEY=
# Endereço do contrato Soroban do Vault de USDC (Testnet)
DEFINDEX_USDC_VAULT_ADDRESS=

# Blend — Soroban Lending ("Borrow & Pay" Orchestrator, Testnet)
# WHY: Todos têm default de testnet no código (services/blend/config.ts); estas
# variáveis só são necessárias se quiser apontar para outro pool/RPC.
# Pool V2 padrão (blend-utils TestnetV2):
BLEND_POOL_ADDRESS=
# RPC Soroban (default: https://soroban-testnet.stellar.org):
SOROBAN_RPC_URL=
# Passphrase da rede (default: Test SDF Network ; September 2015):
STELLAR_NETWORK_PASSPHRASE=